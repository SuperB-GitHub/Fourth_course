		<region region-id="227" left="12" top="194.25" width="326.25" height="144" align-x="12" align-y="204" show-border="false" show-highlight="false" is-protected="true" z-order="-2" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Количество<sp count="2"/>ошибок перед<sp count="2"/>каждым<sp count="2"/>прогоном<sp count="2"/>будем<sp count="2"/>оценивать<sp count="2"/>в </p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">соответствии<sp count="2"/>с<sp count="2"/>выражением.<sp count="2"/>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"/>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"/>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"/>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Перед<sp count="2"/>каждой<sp count="2"/>последующей оценкой количества ошибок и<sp count="2"/>степени<sp count="2"/>отлаженное программы необходимо корректировать значения внесенных<sp count="2"/>W и предполагаемых <i>r </i>ошибок с учетом выявленных и устраненных после каждого прогона тестов.<sp count="2"/>
				</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit"/>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">
					<b>Степень<sp count="2"/>отлаженности<sp count="2"/>программы</b>
					<sp count="2"/>на<sp count="2"/>всех<sp count="2"/>прогонах,<sp count="2"/>
					<b>кроме </b>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>последнего</b>, рассчитывается по комбинаторной формуле.</p>
			</text>
		</region>
